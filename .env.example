# Copy to .env and fill in real values. Never commit .env.

# Groq (v1 provider)
GROQ_API_KEY=
# Verified against the project's Groq account on 2026-11-05.
# If Groq retires this id, choose a current chat model from your Groq catalog.
LLM_MODEL=qwen/qwen3.8-27b

# Optional Admin Passcode for RAG pipeline inspection dashboard
# If left blank or unset, admin inspection dashboard remains disabled.
ADMIN_PASSCODE=

# Later providers (optional, not used in v1)
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=
